# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Local development uses SQLite. For Supabase:
#   DATABASE_URL -> transaction pooler (port 6543), used at runtime
#   DIRECT_URL   -> session pooler / direct (port 5432), used by `migrate`
DATABASE_URL=sqlite:///db.sqlite3
DIRECT_URL=sqlite:///db.sqlite3

# Redis (Channels + Celery)
REDIS_URL=redis://127.0.0.1:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# SMS
SMS_API_KEY=

# Supabase Storage (S3 protocol)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_BUCKET=listings
