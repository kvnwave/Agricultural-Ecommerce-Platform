# Copy this file to .env, then set SECRET_KEY and DEBUG=True for local work.
# Production must keep DEBUG=False.

# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Admin URL path. Use a deployment-specific value and restrict it at the proxy.
DJANGO_ADMIN_PATH=control-panel
# Public HTTPS origin(s), comma-separated, e.g. https://market.example.com
CSRF_TRUSTED_ORIGINS=
# Set True only when the proxy replaces X-Forwarded-Proto with its own scheme.
TRUST_X_FORWARDED_PROTO=False

# Database
# Local development uses SQLite. For Supabase:
#   DATABASE_URL -> transaction pooler (port 6543), used at runtime
#   DIRECT_URL   -> session pooler / direct (port 5432), used by `migrate`
#   Migrations: DATABASE_URL="$DIRECT_URL" python manage.py migrate
DATABASE_URL=sqlite:///db.sqlite3
DIRECT_URL=sqlite:///db.sqlite3
# Set True for Supabase; empty defaults to requiring TLS outside DEBUG.
DB_SSL_REQUIRE=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
# Production requires EMAIL_HOST and DEFAULT_FROM_EMAIL; local development
# prints messages to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Most providers use STARTTLS. For implicit TLS on port 465, set
# EMAIL_USE_TLS=False and EMAIL_USE_SSL=True.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

# Supabase Storage (S3 protocol)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_BUCKET=listings
# Leave empty for a public bucket. Set True to use expiring signed URLs.
SUPABASE_S3_QUERYSTRING_AUTH=
# Optional; defaults to <project>.supabase.co/storage/v1/object/public/<bucket>
SUPABASE_S3_CUSTOM_DOMAIN=
